generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm, unaccent]
}

// ─────────────────────────────────────────────
// KATEGORİ SİSTEMİ — Evrensel, hiyerarşik
// Araç → Otomobil → SUV
// Beyaz Eşya → Klima
// Elektronik → Laptop
// ─────────────────────────────────────────────

model Category {
  id               Int        @id @default(autoincrement())
  slug             String     @unique
  name             String
  parentId         Int?
  parent           Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children         Category[] @relation("CategoryTree")

  // Her kategoriye özgü ürün özellikleri (JSON şema)
  // Araç: { fuel_type, segment, body_type, engine_cc }
  // Klima: { btu, energy_class, inverter }
  // Laptop: { cpu, ram_gb, screen_inch }
  attributeSchema  Json       @default("{}")

  // Her kategoriye özgü yorum soruları (JSON şema)
  // Araç EV: [{ key: "real_range_km", label: "Gerçek menzil (km)", type: "number" }]
  // Klima: [{ key: "real_kwh_month", label: "Aylık kWh tüketimi", type: "number" }]
  reviewFormSchema Json       @default("[]")

  isActive         Boolean    @default(true)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())

  products         Product[]
  tradeListingsWanted TradeListing[]
  savedSearches    SavedSearch[]

  @@map("categories")
}

// ─────────────────────────────────────────────
// MARKA & MODEL — Tüm kategoriler için ortak
// ─────────────────────────────────────────────

model Brand {
  id        Int       @id @default(autoincrement())
  slug      String    @unique
  name      String
  logoUrl   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  models    Model[]
  products  Product[]
  tradeListingsWanted TradeListing[]
  savedSearches SavedSearch[]

  // Fuzzy arama (pg_trgm) — add_pg_trgm_search.sql ile elle uygulandı
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "brands_name_trgm_idx")
  @@map("brands")
}

model Model {
  id        Int       @id @default(autoincrement())
  brandId   Int
  brand     Brand     @relation(fields: [brandId], references: [id])
  slug      String    @unique
  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())

  products  Product[]

  // Fuzzy arama (pg_trgm) — add_pg_trgm_search.sql ile elle uygulandı
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "models_name_trgm_idx")
  @@map("models")
}

// ─────────────────────────────────────────────
// ÜRÜN KATALOGU — Evrensel
// Araç, klima, laptop hepsi buraya girer
// ─────────────────────────────────────────────

model Product {
  id          Int      @id @default(autoincrement())
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  brandId     Int
  brand       Brand    @relation(fields: [brandId], references: [id])
  modelId     Int
  model       Model    @relation(fields: [modelId], references: [id])

  slug        String   @unique
  name        String
  year        Int?
  trimName    String?  // Örn: "Easy", "Urban", "GR Sport", "Long Range"
  imageUrl    String?  // Manuel kurasyon — boşsa Wikipedia fallback kullanılır

  // Kategoriye özgü özellikler — category.attributeSchema'ya göre dolar
  // Araç: { "fuel_type": "EV", "segment": "C", "body_type": "sedan", "ev_range_km": 480 }
  // Klima: { "btu": 12000, "energy_class": "A+++", "inverter": true }
  attributes Json     @default("{}")

  status      ProductStatus @default(ACTIVE)
  isActive    Boolean  @default(true)
  viewCount       Int      @default(0)
  weeklyViewCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userProducts    UserProduct[]
  reviews         Review[]
  photos          ProductPhoto[]
  suggestions     VehicleSuggestion[]
  questions       Question[]
  insuranceLeads  InsuranceLead[]
  saleLeads       SaleLead[]
  tradeListings   TradeListing[]
  contentReports  ContentReport[]
  favorites       Favorite[]

  // Fuzzy arama (pg_trgm) — add_pg_trgm_search.sql ile elle uygulandı
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

// Sahiplik/durum bilgisi taşımayan hafif "ilgileniyorum" işareti — garajdan
// (UserProduct) farkı: hiç sahiplik iddiası yok, tek amacı takip listesi.
model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("favorites")
}

// ─────────────────────────────────────────────
// KULLANICI — 4 kademeli güven sistemi
// ─────────────────────────────────────────────

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  passwordHash    String
  // Şifre değiştirildiğinde/sıfırlandığında set edilir — jwt() callback'i bunu
  // token'ın oluşturulma zamanıyla karşılaştırıp eski oturumları geçersiz kılar.
  passwordChangedAt DateTime?

  // Kişisel bilgiler — minimum tutulur (KVKK)
  displayName     String?
  avatarUrl       String?

  // 0: Anonim  1: E-posta doğrulamalı  2: Beyan edilen sahip  3: Doğrulanmış sahip
  trustLevel      Int      @default(1)

  emailVerifiedAt DateTime?

  // Bildirim e-postaları (yorum yayınlandı, soru cevaplandı vb.) — kapatılabilir.
  // Auth e-postaları (doğrulama, şifre sıfırlama) bundan etkilenmez, her zaman gider.
  emailNotificationsEnabled Boolean @default(true)

  // Fake review tespiti için — kullanıcıya gösterilmez
  deviceFingerprint String?

  isBanned        Boolean  @default(false)
  banReason       String?
  bannedAt        DateTime?

  // KVKK: hesap silme talebi
  deletionRequestedAt DateTime?

  // Referral/davet sistemi — parasal olmayan statü rozeti
  referralCode      String   @unique
  referredByUserId  Int?
  referredByUser    User?    @relation("Referrals", fields: [referredByUserId], references: [id])
  referrals         User[]   @relation("Referrals")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userProducts        UserProduct[]
  reviews             Review[]
  reviewVerifications ReviewVerification[]
  reviewFlags         ReviewFlag[]
  helpfulVotes        ReviewHelpfulVote[]
  consentLogs         ConsentLog[]
  dataDeletionRequests DataDeletionRequest[]
  vehicleSuggestions  VehicleSuggestion[]
  productPhotos       ProductPhoto[]        @relation("UserProductPhotos")
  moderationLogs      ModerationLog[]
  questions           Question[]
  answers             Answer[]
  insuranceLeads      InsuranceLead[]
  saleLeads           SaleLead[]
  plusWaitlistEntries PlusWaitlistEntry[]
  notifications       Notification[]
  tradeListings       TradeListing[]
  threadsInitiated    MessageThread[] @relation("ThreadInitiator")
  messagesSent        Message[]       @relation("MessageSender")
  threadsBlocked      MessageThread[] @relation("ThreadBlockedBy")
  threadsInterestLost MessageThread[] @relation("ThreadInterestLostBy")
  messageReports      MessageReport[]
  tradeListingReports TradeListingReport[]
  contentReports      ContentReport[]
  favorites           Favorite[]
  blockedUsers        BlockedUser[] @relation("Blocker")
  blockedByUsers      BlockedUser[] @relation("Blocked")
  savedSearches       SavedSearch[]
  tradeRatingsGiven    TradeRating[] @relation("TradeRater")
  tradeRatingsReceived TradeRating[] @relation("TradeRated")

  @@map("users")
}

// ─────────────────────────────────────────────
// SİTE İÇİ BİLDİRİMLER — e-posta tercihinden bağımsız,
// her zaman oluşturulur (bkz. src/lib/notification.ts)
// ─────────────────────────────────────────────

enum NotificationType {
  NEW_QUESTION
  QUESTION_ANSWERED
  REVIEW_PUBLISHED
  REVIEW_HELPFUL
  NEW_MODEL_IN_BRAND
  REMINDER
  UPDATE_REMINDER
  TRADE_INTEREST
  NEW_TRADE_MESSAGE
  SAVED_SEARCH_MATCH
  TRADE_INTEREST_LOST
  TRADE_RATED
  TRADE_MUTUAL_MATCH
}

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id])

  type      NotificationType
  message   String
  link      String
  isRead    Boolean          @default(false)

  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// GARAJ — Kullanıcı-Ürün ilişkisi
// "Bu ürüne sahibim / kullandım"
// ─────────────────────────────────────────────

model UserProduct {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])

  // Araç için: km bilgisi
  // Genel: sahiplik süresi
  ownershipStatus OwnershipStatus @default(CURRENT)
  soldAt          DateTime?
  soldReason      String[] @default([])
  soldReasonNote  String?  @db.VarChar(200)

  // Satın alma bilgisi — sahiplik süresini ve ileride ortalama fiyat/tarih
  // analizini gerçek tarihlere dayandırmak için (bkz. saleType/salePrice notu).
  purchasedAt   DateTime?
  purchasePrice Int?

  // Satış detayı — nakit satışta satış fiyatı, takasta aracın kendi değeri (TL).
  // Profilde/araç sayfasında tek tek gösterilmez, yalnızca toplu/anonim
  // ortalama piyasa fiyatı istatistiği için kullanılır.
  saleType            SaleType?
  salePrice           Int?
  tradeExtraDirection TradeExtraDirection?
  tradeExtraAmount    Int?

  // Araç için km, diğer ürünler için kullanım miktarı (opsiyonel)
  usageAmount     Int?
  usageUnit       String?  // "km", "saat", "yıkama_sayisi" vb.

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  reviews         Review[]
  tradeListings   TradeListing[]

  @@unique([userId, productId])
  @@map("user_products")
}

enum ProductStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum SaleType {
  CASH
  TRADE
}

enum TradeExtraDirection {
  PAID_EXTRA
  RECEIVED_EXTRA
  EVEN
}

enum OwnershipStatus {
  CURRENT   // Hâlâ kullanıyor
  PAST      // Daha önce kullandı
}

// ─────────────────────────────────────────────
// YORUM — Evrensel çekirdek
// ─────────────────────────────────────────────

model Review {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  productId     Int
  product       Product  @relation(fields: [productId], references: [id])
  userProductId Int?
  userProduct   UserProduct? @relation(fields: [userProductId], references: [id])

  // FI·KA·PE puanları — tüm kategorilerde ortak (1-5)
  scoreFiyat      Float  // FI — Fiyat / Para değeri
  scoreKalite     Float  // KA — Kalite / Dayanıklılık
  scorePerformans Float  // PE — Performans / Kullanım deneyimi
  scoreOverall    Float  // Genel memnuniyet (FI×0.30 + KA×0.35 + PE×0.35)

  // Kısa metin — zorunlu
  summaryText   String   @db.VarChar(500)

  // Uzun metin — opsiyonel
  detailText    String?  @db.Text

  // "Tekrar alır mısınız?"
  wouldBuyAgain Boolean?

  // Kullanım süresi yorumu yazarken
  ownershipMonthsAtReview Int?

  // Kategoriye özgü veriler — category.reviewFormSchema'ya göre dolar
  // Araç EV: { "real_range_km": 380, "monthly_charge_cost": 850, "score_charging": 4.0 }
  // Araç ICE: { "real_fuel_per_100km": 7.2, "has_lpg": true }
  // Klima: { "real_kwh_month": 90, "noise_level": "quiet" }
  // Laptop: { "real_battery_hours": 6.5, "throttle_issue": false }
  extendedData  Json     @default("{}")

  // Güven skoru — 0-100, okuyucuya gösterilmez, sıralamada kullanılır
  trustScore    Int      @default(35)

  // Fingerprint — KVKK: ham IP/UA saklanmaz, sadece HMAC hash'i (review bombing tespiti için)
  ipHash        String?
  userAgentHash String?

  // Moderasyon
  status        ReviewStatus @default(PENDING)
  publishedAt   DateTime?
  rejectedAt    DateTime?
  rejectionReason String?

  // Periyodik güncelleme (TrueDelta modeli)
  isUpdate      Boolean  @default(false)
  parentReviewId Int?
  parentReview  Review?  @relation("ReviewUpdates", fields: [parentReviewId], references: [id])
  updates       Review[] @relation("ReviewUpdates")

  nextReminderAt DateTime? // 3 ayda bir güncelleme hatırlatması

  editedAt      DateTime?
  editCount     Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  verification  ReviewVerification?
  flags         ReviewFlag[]
  helpfulVotes  ReviewHelpfulVote[]
  photos        ProductPhoto[]
  contentReports ContentReport[]
  versions      ReviewVersion[]
  scoreSnapshots ScoreSnapshot[]
  moderationLogs ModerationLog[]

  @@map("reviews")
}

// ─────────────────────────────────────────────
// SKOR AUDIT TRAIL — hangi review hangi ağırlıkla
// yayındaki skora katkı sağladı, geçmişe dönük izlenebilirlik
// ─────────────────────────────────────────────

model ScoreSnapshot {
  id           Int            @id @default(autoincrement())
  reviewId     Int
  review       Review         @relation(fields: [reviewId], references: [id])
  productId    Int
  trustScore   Int
  scoreOverall Float
  status       ReviewStatus
  reason       SnapshotReason
  createdAt    DateTime       @default(now())

  @@map("score_snapshots")
}

enum SnapshotReason {
  CREATED
  PUBLISHED
  REJECTED
  EDITED
}

// ─────────────────────────────────────────────
// MODERASYON AUDIT LOG — hangi admin, hangi review'u,
// ne zaman, hangi sebeple onayladı/reddetti
// ─────────────────────────────────────────────

model ModerationLog {
  id          Int              @id @default(autoincrement())
  reviewId    Int
  review      Review           @relation(fields: [reviewId], references: [id])
  moderatorId Int
  moderator   User             @relation(fields: [moderatorId], references: [id])
  action      ModerationAction
  reason      String?          @db.VarChar(300)
  createdAt   DateTime         @default(now())

  @@map("moderation_logs")
}

enum ModerationAction {
  APPROVED
  REJECTED
}

model ReviewVersion {
  id            Int             @id @default(autoincrement())
  reviewId      Int
  review        Review          @relation(fields: [reviewId], references: [id])
  version       Int
  pros          Json            @default("[]")
  cons          Json            @default("[]")
  detailText    String?
  wouldBuyAgain Boolean?
  scoreFiyat    Float?
  scoreKalite   Float?
  scorePerformans Float?
  scoreOverall  Float?
  triggerSource VersionTrigger
  createdAt     DateTime        @default(now())

  @@unique([reviewId, version])
  @@map("review_versions")
}

enum VersionTrigger {
  MANUAL       // Kullanıcı manuel düzenledi
  REMINDER_3M  // 3 aylık hatırlatma emaili üzerinden
}

enum ReviewStatus {
  PENDING    // Moderasyon bekliyor
  PUBLISHED  // Yayında
  REJECTED   // Reddedildi
  HIDDEN     // Gizlendi (flag sonrası)
  DELETED    // Kullanıcı tarafından silindi (soft delete)
}

// ─────────────────────────────────────────────
// DOĞRULAMA — Katmanlı sinyal sistemi
// KVKK: Belge saklanmaz, sadece sonuç tutulur
// ─────────────────────────────────────────────

model ReviewVerification {
  id          Int      @id @default(autoincrement())
  reviewId    Int      @unique
  review      Review   @relation(fields: [reviewId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  // Doğrulama tipi
  verificationType VerificationType

  // AI analiz sonuçları
  aiConfidenceScore Float?   // 0-1 arası
  plateHash         String?  // Plaka değil, hash'i (araçlar için)
  modelMatchScore   Float?   // AI'nin model tanıma skoru

  // EXIF verisi
  photoExifDate     DateTime? // Fotoğrafın çekilme tarihi

  // Mantık kontrol sonuçları
  logicChecks       Json     @default("{}")
  // { "model_year_ok": true, "km_plausible": true, "exif_recent": true }

  // Sonuç
  isVerified        Boolean  @default(false)
  verifiedAt        DateTime?

  // KVKK: Belge yüklendiyse anında silinir
  documentDeletedAt DateTime?

  createdAt   DateTime @default(now())

  @@map("review_verifications")
}

enum VerificationType {
  PHOTO_WITH_PLATE    // Araç: plaka görünür fotoğraf
  PHOTO_WITH_PRODUCT  // Diğer: ürün etiketi görünür fotoğraf
  INVOICE             // Sıfır ürün faturası
  INSURANCE_POLICY    // Trafik sigortası (araç, ikinci el)
  SELF_DECLARED       // Beyan — belge yok
}

// ─────────────────────────────────────────────
// TOPLULUK RAPORLAMA
// ─────────────────────────────────────────────

model ReviewFlag {
  id          Int        @id @default(autoincrement())
  reviewId    Int
  review      Review     @relation(fields: [reviewId], references: [id])
  reporterId  Int
  reporter    User       @relation(fields: [reporterId], references: [id])

  reason      FlagReason
  description String?    @db.VarChar(300)

  status      FlagStatus @default(PENDING)
  resolvedAt  DateTime?
  resolvedBy  Int?       // Admin user id

  createdAt   DateTime   @default(now())

  @@unique([reviewId, reporterId])
  @@map("review_flags")
}

enum FlagReason {
  FAKE_REVIEW       // Sahte yorum
  SPAM              // Spam
  OFFENSIVE         // Hakaret / uygunsuz içerik
  PERSONAL_DATA     // Kişisel veri içeriyor
  WRONG_PRODUCT     // Yanlış ürün yorumu
  OTHER
}

enum FlagStatus {
  PENDING    // İnceleme bekliyor
  DISMISSED  // Reddedildi (yorum temiz)
  ACTIONED   // İşlem yapıldı (yorum kaldırıldı/düzenlendi)
}

// ─────────────────────────────────────────────
// FAYDALANDI OYU
// ─────────────────────────────────────────────

model ReviewHelpfulVote {
  id        Int     @id @default(autoincrement())
  reviewId  Int
  review    Review  @relation(fields: [reviewId], references: [id])
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  isHelpful Boolean // true = faydalı, false = faydasız

  createdAt DateTime @default(now())

  @@unique([reviewId, userId])
  @@map("review_helpful_votes")
}

// ─────────────────────────────────────────────
// KVKK UYUM TABLOLARI
// ─────────────────────────────────────────────

// Kullanıcının ne zaman, neyi onayladığı
model ConsentLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  consentType ConsentType
  isGranted   Boolean
  ipAddress   String?
  userAgent   String?

  createdAt   DateTime @default(now())

  @@map("consent_logs")
}

enum ConsentType {
  PRIVACY_POLICY      // Gizlilik politikası
  TERMS_OF_SERVICE    // Kullanım koşulları
  MARKETING_EMAIL     // Pazarlama e-postası
  ANALYTICS_COOKIES   // Analitik çerezler
  TRADE_LISTING       // Takas ilanı açarken il/iletişim verisinin diğer kullanıcılara gösterilmesine rıza
}

// "Verilerimi sil" talepleri
model DataDeletionRequest {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  reason      String?  @db.VarChar(500)
  status      DeletionStatus @default(PENDING)

  requestedAt DateTime @default(now())
  // KVKK: 30 gün içinde tamamlanmalı
  dueAt       DateTime
  completedAt DateTime?
  completedBy Int?

  @@index([userId])
  @@index([status])
  @@map("data_deletion_requests")
}

enum DeletionStatus {
  PENDING     // Bekliyor
  IN_PROGRESS // İşleniyor
  COMPLETED   // Tamamlandı
  REJECTED    // Reddedildi (geçerli sebep yok)
}

// ─────────────────────────────────────────────
// ARAÇ ÖNERİSİ — Kullanıcı tarafından gönderilen
// ─────────────────────────────────────────────

model VehicleSuggestion {
  id           Int      @id @default(autoincrement())
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])

  brandName    String
  modelName    String
  year         Int?
  categorySlug String
  fuelType     String?
  transmission String?
  trimName     String?
  notes        String?  @db.VarChar(500)

  // CarQuery'den seçilen ham veri
  carQueryData Json?

  // Admin onayı sırasında hesaplanan alan-bazlı güven skoru/kaynak
  // ({ engine_cc: { confidence, source, conflictWith? }, ... }) — hangi
  // teknik özelliğin ne kadar güvenilir olduğunu geriye dönük izlemek için.
  specConfidence Json?

  // Öneri kabul edildiğinde oluşturulan ürün (PENDING → ACTIVE)
  productId    Int?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Kullanıcının aynı anda yazdığı bekleyen yorum verisi (legacy)
  reviewData   Json?

  // Yorum sırasında yüklenen fotoğraflar (Vercel Blob URL'leri)
  photoUrls    String[] @default([])

  status       SuggestionStatus @default(PENDING)
  adminNote    String?

  createdAt    DateTime @default(now())
  reviewedAt   DateTime?
  reviewedBy   Int?

  // Supabase'de elle oluşturulmuş index'ler
  @@index([status], map: "idx_vs_status")
  @@index([userId], map: "idx_vs_user")
  @@map("vehicle_suggestions")
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// ÜRÜN FOTOĞRAFLARI — Kullanıcı yüklemeli
// ─────────────────────────────────────────────

model ProductPhoto {
  id               Int         @id @default(autoincrement())
  productId        Int
  product          Product     @relation(fields: [productId], references: [id])
  uploadedByUserId Int?
  uploadedBy       User?       @relation("UserProductPhotos", fields: [uploadedByUserId], references: [id])
  reviewId         Int?
  review           Review?     @relation(fields: [reviewId], references: [id])

  url              String
  status           PhotoStatus @default(PENDING)
  order            Int         @default(0)

  // Perceptual hash (dHash, 64-bit hex) — görsel olarak tekrar kullanılan fotoğraf tespiti için
  phash            String?

  createdAt        DateTime    @default(now())

  contentReports   ContentReport[]

  @@map("product_photos")
}

enum PhotoStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// SORU-CEVAP — Model sayfasında, sahiplik yorumcularına
// bildirim giden uzun kuyruk SEO + retention modülü
// ─────────────────────────────────────────────

model Question {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  text      String   @db.VarChar(300)

  createdAt DateTime @default(now())

  answers   Answer[]
  contentReports ContentReport[]

  @@index([productId])
  @@map("questions")
}

model Answer {
  id         Int      @id @default(autoincrement())
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])

  text       String   @db.VarChar(500)

  createdAt  DateTime @default(now())

  @@index([questionId])
  @@map("answers")
}

// ─────────────────────────────────────────────
// SİGORTA LEAD — Garaj'daki araç için opt-in sigorta teklifi talebi
// Şu an gerçek partner/API entegrasyonu YOK — sadece pasif kayıt,
// admin panelden görüntülenip ileride partnerlere manuel aktarılacak.
// Skor/yorum akışından tamamen ayrı, opsiyonel bir katman (kırmızı çizgi).
// ─────────────────────────────────────────────

model InsuranceLead {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  fullName  String   @db.VarChar(100)
  phone     String   @db.VarChar(20)

  status    LeadStatus @default(NEW)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@map("insurance_leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  PENDING
  COMPLETED
  NOT_DONE
}

// ─────────────────────────────────────────────
// SATIŞ ANI LEAD — "Sattım" formunu AÇTIĞI an (henüz kaydetmeden,
// satış niyeti anı) gösterilen opt-in ekspertiz/hızlı teklif talebi.
// Gerçek partner/API entegrasyonu YOK — sadece pasif kayıt.
// Ekspertiz ve hızlı teklif ayrı dikeyler (farklı partner ekosistemleri),
// bu yüzden tür bazlı ayrı kayıt tutuluyor.
// ─────────────────────────────────────────────

model SaleLead {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  type      SaleLeadType
  fullName  String   @db.VarChar(100)
  phone     String   @db.VarChar(20)

  status    LeadStatus @default(NEW)

  createdAt DateTime @default(now())

  @@unique([userId, productId, type])
  @@map("sale_leads")
}

enum SaleLeadType {
  EXPERTISE
  QUICK_OFFER
}

// ─────────────────────────────────────────────
// FIKAPE PLUS BEKLEME LİSTESİ — Gerçek ödeme YOK.
// Gelişmiş filtre/kayıtlı arama gibi Plus özellikleri için önce
// talep sinyali toplanıyor (fake door test); Stripe/iyzico entegrasyonu
// ancak yeterli ilgi birikince ayrı bir turda ele alınacak.
// ─────────────────────────────────────────────

model PlusWaitlistEntry {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  email     String   @db.VarChar(255)
  note      String?  @db.VarChar(280)

  createdAt DateTime @default(now())

  @@unique([email])
  @@map("plus_waitlist_entries")
}

// ─────────────────────────────────────────────
// TAKASA AÇ — Garaj'daki araç için "takasa açık" işareti.
// 1 ilan = 1 mesajlaşma thread'i modeli (genel DM sistemi YOK).
// Erişim: trustLevel >= 3 (garajda araç + fotoğraflı + onaylı yorum)
// ─────────────────────────────────────────────

model TradeListing {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  productId       Int
  product         Product  @relation(fields: [productId], references: [id])
  userProductId   Int
  userProduct     UserProduct @relation(fields: [userProductId], references: [id], onDelete: Cascade)

  wantCategoryId  Int?
  wantCategory    Category? @relation(fields: [wantCategoryId], references: [id])
  wantBrandId     Int?
  wantBrand       Brand?    @relation(fields: [wantBrandId], references: [id])
  wantAnything    Boolean  @default(false)
  // İlan sahibinin karşı taraftan beklediği konum kapsamı + kabul edebileceği
  // hasar durumları — kullanıcı geri bildirimi: ilan sadece KENDİ aracının
  // (city alanı) nerede olduğunu söylüyordu, aradığı aracın nerede/nasıl
  // olmasını istediğini hiç belirtemiyordu. İkisi de opsiyonel; boş/varsayılan
  // durumda "hiç kısıtlama yok" anlamına gelir (Türkiye geneli / tüm hasar
  // durumları) — @default değerleri bunun için var, formda boş bırakılırsa
  // otomatik bu değere düşer.
  wantLocationScope  TradeLocationScope   @default(NATIONWIDE)
  wantDamageStatuses TradeDamageStatus[]  @default([])
  // Aradığı aracın yıl/km aralığı + yakıt/vites tercihi — kullanıcı geri
  // bildirimi: "Aradığınız Araç" bölümü sadece kategori/marka/konum/hasar
  // biliyordu, yıl/km/yakıt/vites hiç sorulmuyordu. Hepsi opsiyonel — boş
  // bırakılırsa (min/max null, diziler boş) o kritere göre kısıtlama yok.
  wantYearMin     Int?
  wantYearMax     Int?
  wantKmMin       Int?
  wantKmMax       Int?
  wantFuelTypes   TradeFuelType[] @default([])
  // Vites değerleri kategoriye göre serbest metin (Product.attributes.transmission
  // ile aynı sözlük: "Manuel"/"Otomatik"/"CVT"/"Yarı Otomatik") — sabit bir enum
  // yerine dizi, ileride kategoriye özel yeni bir vites tipi eklenirse migration
  // gerekmesin diye.
  wantTransmissions String[] @default([])
  note            String?  @db.VarChar(300)
  // "note" kısa bir takas beklentisi notu ("sadece dizel arıyorum" gibi) — bu
  // ayrı bir alan: aracın kendisi hakkında serbest, uzun açıklama (km, bakım
  // geçmişi vb.). İkisi karıştırılmasın diye bilinçli olarak ayrı tutuldu.
  description     String?  @db.VarChar(2000)

  paymentIntent   TradePaymentIntent @default(SWAP_ONLY)
  city            String   @db.VarChar(50)   // sadece İl, ilçe yok — TURKISH_CITIES whitelist'ine karşı validate edilir

  isActive        Boolean  @default(true)
  closedAt        DateTime?
  closeReason     TradeCloseReason?
  // 6 ay sonra anonimleştirme cron'unun bu ilanı işleyip işlemediğini işaretler —
  // önceden bu iş tekrarlanabilirliği mesaj metnindeki placeholder'a bakarak
  // (implicit) kontrol ediyordu; ilanın kendi notu (serbest metin, PII riski
  // taşıyabilir) hiç temizlenmiyordu (bkz. denetim raporu "gerçek anonimleştirme
  // değil" maddesi).
  anonymizedAt    DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // "İlan Yenile" — createdAt'ı DEĞİŞTİRMEDEN (ilanın gerçek açılış tarihi
  // korunur) sıralamayı öne almak için ayrı bir alan. Oluşturmada createdAt'la
  // aynı, yenilemede tekrar now()'a set edilir. Kötüye kullanımı önlemek için
  // API'de cooldown uygulanır (bkz. boşluk raporu, DÜŞÜK madde).
  effectiveDate   DateTime @default(now())

  threads         MessageThread[]
  reports         TradeListingReport[]
  partConditions  TradeListingPartCondition[]

  // Hasar Durumu — kullanıcı beyanı, fikape tarafından doğrulanmamış (araç
  // sayfası/ilan sekmesinde bunu belirten bir uyarı gösterilir). Motor/
  // şanzıman/yürüyen aksam CAR_PARTS gibi dinamik bir liste değil, sabit 3
  // bileşen olduğu için (Boyalı/Değişen Parça'daki gibi ayrı bir ilişki
  // tablosu yerine) doğrudan kolon olarak tutuluyor — bkz. src/lib/damageStatus.ts.
  damageStatus          TradeDamageStatus?
  engineCondition       MechanicalCondition?
  engineNote            String?              @db.VarChar(300)
  transmissionCondition MechanicalCondition?
  transmissionNote      String?              @db.VarChar(300)
  runningGearCondition  MechanicalCondition?
  runningGearNote       String?              @db.VarChar(300)
  tramerRecords         TradeTramerRecord[]

  // NOT: Prisma @@unique([userProductId]) YOK (kapanan ilan yeniden açılamama
  // bug'ına yol açar). Bunun yerine migration SQL'ine ELLE bir PARTIAL UNIQUE
  // INDEX eklenir:
  //   CREATE UNIQUE INDEX trade_listings_active_user_product_key
  //   ON trade_listings ("userProductId") WHERE "isActive" = true;
  @@index([userProductId, isActive])
  @@index([city, isActive])
  @@index([userId])
  @@map("trade_listings")
}

enum TradePaymentIntent {
  SWAP_ONLY
  PAYS_EXTRA
  WANTS_EXTRA
}

// Kayıtlı arama — kullanıcı /takas'ta il+kategori/marka filtresi kaydedip, o
// kritere uyan yeni bir ilan açıldığında bildirim alır. Önceden kullanıcı
// pasif tarama yapmak zorundaydı, kayıtlı arama/eşleşme bildirimi hiç yoktu
// (bkz. denetim raporu).
//
// Önceden sadece city/categoryId/brandId saklanıyordu — ödeme niyeti, yıl/km
// aralığı, yakıt/vites filtreleri kaydediliyor GÖRÜNÜYOR ama sessizce yok
// sayılıyordu (bkz. kullanıcı geri bildirimi, ekran görüntüsü). Serbest metin
// (q) kasıtlı olarak DIŞARIDA — JS-tarafı aksan-duyarsız arama, DB seviyesinde
// yeni-ilan tetiklemesiyle eşleştirilemez.
//
// criteriaKey: tüm kriterlerin kanonik (sıralı) serileştirmesi — array
// kolonları üzerinde unique constraint yerine tek bir string üzerinden
// tekilleştirme yapmak için (bkz. api/saved-searches/route.ts buildCriteriaKey).
model SavedSearch {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  city            String   @db.VarChar(50)
  categoryId      Int?
  category        Category? @relation(fields: [categoryId], references: [id])
  brandId         Int?
  brand           Brand?    @relation(fields: [brandId], references: [id])
  paymentIntent   TradePaymentIntent?
  yearMin         Int?
  yearMax         Int?
  kmMin           Int?
  kmMax           Int?
  fuelTypes       TradeFuelType[] @default([])
  transmissions   String[] @default([])
  criteriaKey     String   @default("")
  createdAt       DateTime @default(now())

  @@unique([userId, criteriaKey])
  @@index([city])
  @@map("saved_searches")
}

enum TradeCloseReason {
  TRADED
  GAVE_UP
  FOUND_ELSEWHERE
}

model MessageThread {
  id              Int      @id @default(autoincrement())
  tradeListingId  Int
  tradeListing    TradeListing @relation(fields: [tradeListingId], references: [id], onDelete: Cascade)
  initiatorId     Int
  initiator       User     @relation("ThreadInitiator", fields: [initiatorId], references: [id])
  createdAt       DateTime @default(now())
  lastMessageAt   DateTime @default(now())
  hasReciprocalReply Boolean @default(false)

  // Görüşmeyi sonlandırma — kim dondurduğunu tutar
  blockedByUserId Int?
  blockedByUser   User?    @relation("ThreadBlockedBy", fields: [blockedByUserId], references: [id])
  blockedAt       DateTime?

  // "İlgimi kaybettim" — Block'tan farklı: mesajlaşmayı KAPATMAZ, sadece
  // karşı tarafa (genelde ilan sahibine) yumuşak bir sinyal verir. Önceden
  // sadece ilan sahibi ilanı kapatabiliyordu, görüşmeyi başlatan tarafın
  // vazgeçtiğini belirtecek bir yolu yoktu — iki taraf da sessiz kalırsa ilan
  // süresiz aktif kalıyordu (bkz. boşluk raporu, YÜKSEK madde).
  interestLostByUserId Int?
  interestLostByUser   User?    @relation("ThreadInterestLostBy", fields: [interestLostByUserId], references: [id])
  interestLostAt       DateTime?

  messages        Message[]
  ratings         TradeRating[]

  @@unique([tradeListingId, initiatorId])
  @@index([initiatorId])
  @@map("message_threads")
}

// Takas sonrası karşılıklı değerlendirme — önceden hiç yoktu, güven takas
// geçmişinden hiç birikmiyordu (bkz. denetim raporu, KRİTİK madde). Thread
// bazında (ilan değil): bir ilanda birden çok görüşme olabilir, hangisinin
// gerçek takasla sonuçlandığını sadece taraflar bilir — o yüzden ilan
// TRADED ile kapandığında HER thread'in tarafları birbirini değerlendirebilir,
// gerçekte takas etmedikleri biriyle karşılaşan taraf değerlendirmeyi atlar.
model TradeRating {
  id          Int           @id @default(autoincrement())
  threadId    Int
  thread      MessageThread @relation(fields: [threadId], references: [id])
  raterId     Int
  rater       User          @relation("TradeRater", fields: [raterId], references: [id])
  ratedUserId Int
  ratedUser   User          @relation("TradeRated", fields: [ratedUserId], references: [id])
  score       Int           // 1-5
  comment     String?       @db.VarChar(300)
  createdAt   DateTime      @default(now())

  @@unique([threadId, raterId])
  @@index([ratedUserId])
  @@map("trade_ratings")
}

// Kullanıcı-bazlı, kalıcı blok — MessageThread.blockedByUserId sadece TEK bir
// görüşmeyi donduruyordu; bloklanan kişi yeni bir ilan/thread üzerinden tekrar
// ulaşabiliyordu (bkz. denetim raporu). Bu tablo bloğu kullanıcı çifti bazında
// kalıcı hale getirir, yeni ilan/thread açma route'larında kontrol edilir.
model BlockedUser {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id])
  blockedId Int
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocked_users")
}

model Message {
  id        Int           @id @default(autoincrement())
  threadId  Int
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User          @relation("MessageSender", fields: [senderId], references: [id])
  text      String        @db.VarChar(1000)
  isRead    Boolean       @default(false)
  createdAt DateTime      @default(now())

  reports   MessageReport[]

  @@index([threadId, createdAt])
  @@map("messages")
}

model MessageReport {
  id         Int                 @id @default(autoincrement())
  messageId  Int
  message    Message             @relation(fields: [messageId], references: [id])
  reporterId Int
  reporter   User                @relation(fields: [reporterId], references: [id])
  reason     MessageReportReason
  note       String?             @db.VarChar(300)
  status     MessageReportStatus @default(PENDING)
  createdAt  DateTime            @default(now())

  // Postgres FK'leri otomatik index'lemiyor — admin panelde mesaj/kullanıcı bazlı
  // rapor sorguları büyüdükçe tam tablo taraması riski taşıyordu (bkz. denetim raporu).
  @@index([messageId])
  @@index([reporterId])
  @@index([status])
  @@map("message_reports")
}

// İlanın kendisini (fotoğraf, içerik, sahte/spam ilan şüphesi) hedefleyen rapor —
// MessageReport mesaj bazlı, bu ilan bazlı. Aynı reason/status enum'ları paylaşılıyor,
// admin tarafında aynı sayfada (mesaj-raporlari) birlikte listeleniyor.
model TradeListingReport {
  id             Int                 @id @default(autoincrement())
  tradeListingId Int
  tradeListing   TradeListing        @relation(fields: [tradeListingId], references: [id])
  reporterId     Int
  reporter       User                @relation(fields: [reporterId], references: [id])
  reason         MessageReportReason
  note           String?             @db.VarChar(300)
  status         MessageReportStatus @default(PENDING)
  createdAt      DateTime            @default(now())

  @@index([tradeListingId])
  @@index([reporterId])
  @@index([status])
  @@map("trade_listing_reports")
}

// Boyalı/Değişen Parça — ilana bağlı (Product/UserProduct'a değil): bu, o
// SPESİFİK aracın o andaki fiziksel durumu, model geneli bir özellik değil.
// partKey sabit bir whitelist'ten gelir (bkz. src/lib/carParts.ts), sadece
// gövde paneli olan kategorilerde (otomobil/kamyonet) kullanılır.
model TradeListingPartCondition {
  id             Int           @id @default(autoincrement())
  tradeListingId Int
  tradeListing   TradeListing  @relation(fields: [tradeListingId], references: [id], onDelete: Cascade)
  partKey        String        @db.VarChar(50)
  condition      PartCondition

  @@unique([tradeListingId, partKey])
  @@map("trade_listing_part_conditions")
}

enum PartCondition {
  ORIGINAL
  LOCAL_PAINT
  PAINTED
  REPLACED
}

// Tramer kayıtları — bir ilanda birden fazla kaza/tamir geçmişi olabilir,
// bu yüzden TradeListingPartCondition'daki aynı gerekçeyle (o SPESİFİK
// aracın o andaki durumu, model geneli değil) ayrı bir tek-çok tablo.
model TradeTramerRecord {
  id             Int          @id @default(autoincrement())
  tradeListingId Int
  tradeListing   TradeListing @relation(fields: [tradeListingId], references: [id], onDelete: Cascade)
  month          Int          // 1-12
  year           Int
  amount         Float        // TL

  @@index([tradeListingId])
  @@map("trade_tramer_records")
}

enum TradeDamageStatus {
  NONE    // Hasarsız
  DAMAGED // Hasarlı
  HEAVY   // Ağır Hasarlı
}

// İlan sahibinin, takas edeceği aracın ne kadar uzakta olabileceğine dair
// beklentisi — otomatik bir mesafe/bölge hesaplaması yapılmıyor, sadece
// diğer kullanıcıya gösterilen bir beklenti etiketi (city alanındaki gibi
// gerçek bir konum değil, bir tercih).
enum TradeLocationScope {
  SAME_CITY   // Aynı Şehirde
  SAME_REGION // Aynı Bölgede
  NATIONWIDE  // Türkiye Genelinde
}

// vehicleSuggestSchema'daki fuelType enum'uyla aynı değer seti — Product.attributes
// JSON'ında string olarak tutulan "fuel_type" ile birebir eşleşir (bkz. specFields.ts).
enum TradeFuelType {
  GASOLINE
  DIESEL
  EV
  PHEV
  HYBRID
  LPG
}

// Motor/Şanzıman/Yürüyen Aksam için ortak 5 durumlu model — kullanıcı geri
// bildirimiyle düz "Var/Yok" yetersiz bulundu (orijinal mi yan sanayi mi
// parça, geçmişte mi giderildi yoksa hâlâ mı sürüyor gibi ayrımlar kayboluyordu).
enum MechanicalCondition {
  ORIGINAL             // Orijinal / Sorunsuz
  MINOR_FIXED          // Küçük Sorun — Giderildi
  REPLACED_OEM         // Orijinal Parça ile Değişti
  REPLACED_AFTERMARKET // Yan Sanayi Parça ile Değişti
  ONGOING_ISSUE        // Devam Eden Sorun Var
}

enum MessageReportReason {
  SPAM
  SCAM_ATTEMPT
  OFFENSIVE
  OTHER
}

enum MessageReportStatus {
  PENDING
  REVIEWED
}

// ─────────────────────────────────────────────
// İÇERİK HATASI BİLDİRİMİ — araç sayfasındaki teknik özellik,
// fotoğraf, yorum veya soru-cevap içeriğinde hata bildirimi.
// ReviewFlag/MessageReport'tan farklı: kötüye kullanım şikayeti değil,
// "bu bilgi yanlış, düzeltilmeli" — admin aksiyonu moderasyon değil düzeltme.
// ─────────────────────────────────────────────

model ContentReport {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  reporterId Int
  reporter   User     @relation(fields: [reporterId], references: [id])

  targetType ContentReportTargetType

  // Hedefe göre yalnızca ilgili alan doldurulur
  field      String?       @db.VarChar(100) // targetType=SPEC ise (örn. "ev_range_km")
  photoId    Int?
  photo      ProductPhoto? @relation(fields: [photoId], references: [id])
  reviewId   Int?
  review     Review?       @relation(fields: [reviewId], references: [id])
  questionId Int?
  question   Question?     @relation(fields: [questionId], references: [id])

  note       String   @db.VarChar(500)

  status     ContentReportStatus @default(PENDING)
  resolvedAt DateTime?
  resolvedBy Int?      // Admin user id
  adminNote  String?   @db.VarChar(300)

  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([status])
  @@map("content_reports")
}

enum ContentReportTargetType {
  SPEC
  PHOTO
  REVIEW
  QNA
  OTHER
}

enum ContentReportStatus {
  PENDING
  RESOLVED
  REJECTED
}
